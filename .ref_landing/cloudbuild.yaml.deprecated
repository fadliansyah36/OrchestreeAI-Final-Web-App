steps:
  - name: 'gcr.io/cloud-builders/docker'
    entrypoint: 'bash'
    args:
      - '-c'
      - |
        # Use secret from Secret Manager if provided via secretEnv, otherwise fallback to substitution variable
        ANON_KEY="$$VITE_SUPABASE_ANON_KEY"
        if [ -z "$$ANON_KEY" ]; then
          ANON_KEY="${_VITE_SUPABASE_ANON_KEY}"
        fi

        docker build \
          --build-arg VITE_SUPABASE_ANON_KEY="$$ANON_KEY" \
          --build-arg VITE_SUPABASE_URL="${_VITE_SUPABASE_URL}" \
          --build-arg VITE_BACKEND_API_URL="${_VITE_BACKEND_API_URL}" \
          --build-arg NEXT_PUBLIC_BACKEND_API_URL="${_VITE_BACKEND_API_URL}" \
          -t "${_IMAGE_REPO}/admin-dashboard:${_IMAGE_TAG}" \
          .
    secretEnv: ['VITE_SUPABASE_ANON_KEY']

  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - '${_IMAGE_REPO}/admin-dashboard:${_IMAGE_TAG}'

images:
  - '${_IMAGE_REPO}/admin-dashboard:${_IMAGE_TAG}'

substitutions:
  _VITE_SUPABASE_ANON_KEY: ''
  _VITE_SUPABASE_URL: 'https://exfvfyiwftywqjcsofgf.supabase.co'
  _VITE_BACKEND_API_URL: 'https://api.orchestree.biz.id/api/v1'
  _IMAGE_REPO: 'asia-southeast2-docker.pkg.dev/orchestree-ai/orchestreeai-images'
  _IMAGE_TAG: 'latest'

availableSecrets:
  secretManager:
    - versionName: projects/$PROJECT_ID/secrets/VITE_SUPABASE_ANON_KEY/versions/latest
      env: 'VITE_SUPABASE_ANON_KEY'

options:
  logging: CLOUD_LOGGING_ONLY
