{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@orchestree/ui": ["./packages/ui/src/index.ts"],
      "@orchestree/design-tokens": ["./packages/design-tokens/src/index.ts"],
      "@orchestree/api-types": ["./packages/api-types/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["packages/**/*", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["apps/client", "apps/admin", "node_modules"]
}