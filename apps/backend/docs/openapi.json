      "get": {
        "tags": ["tokenopt"],
        "summary": "Get Token Savings Logs",
        "description": "Mengambil riwayat telemetri penghematan token dan audit cache hit/miss.",
        "operationId": "get_token_savings_logs",
        "parameters": [
          { "name": "tenant_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 50 } }
