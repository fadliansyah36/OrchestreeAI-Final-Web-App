    },
    "/api/v1/tenants/{tenant_id}/agent-catalog/available": {
      "get": {
        "tags": ["agent-catalog-tenant"],
        "summary": "List Available Blueprints For Tenant",
        "description": "Mengambil daftar blueprint yang dapat diakses oleh tenant (GA atau BETA yang diizinkan).",
        "operationId": "list_available_for_tenant",
        "parameters": [
          { "name": "tenant_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Successful Response", "content": { "application/json": { "schema": {} } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
