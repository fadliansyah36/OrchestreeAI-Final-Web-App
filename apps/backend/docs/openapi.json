    "/api/v1/tenant/company-codes": {
      "post": {
        "tags": [
          "Tenant Security & Operations"
        ],
        "summary": "Generate Company Code (Owner / Tenant Admin)",
        "description": "Membuat kode registrasi perusahaan baru (CSPRNG):\n- Plain-text kode hanya dikembalikan satu kali dalam respons API ini.\n- Hanya hash SHA-256 yang disimpan di database `tenant_company_codes`.",
        "operationId": "create_company_code_api_v1_tenant_company_codes_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompanyCodeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCompanyCodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenant/hr-queue": {
      "get": {
        "tags": [
          "Tenant Security & Operations"
        ],
        "summary": "Daftar Antrean HR Approval (Owner / Admin / Manager)",
        "description": "Mengambil daftar calon staf yang mengajukan pendaftaran ke perusahaan.\nDilindungi oleh PDP dengan kapabilitas `hr.approval.review`.",
        "operationId": "list_hr_queue_api_v1_tenant_hr_queue_get",
        "parameters": [
          {
            "name": "queue_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "pending",
              "title": "Queue Status"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HRQueueItemResponse"
                  },
                  "title": "Response List Hr Queue Api V1 Tenant Hr Queue Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenant/hr-queue/{queue_id}/review": {
      "post": {
        "tags": [
          "Tenant Security & Operations"
        ],
        "summary": "Review Antrean HR Approval (Approve / Reject Staf)",
        "description": "Menyetujui atau menolak pendaftaran staf:\n- Jika 'approved': buat `tenant_memberships` (role `STAFF_HUMAN`), update queue jadi 'approved', update use_count kode.\n- Jika 'rejected': update status queue menjadi 'rejected' beserta alasan penolakan.",
        "operationId": "review_hr_queue_api_v1_tenant_hr_queue__queue_id__review_post",
        "parameters": [
          {
            "name": "queue_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Queue Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewHRQueueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewHRQueueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/onboarding/register-tenant": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Registrasi Tenant Baru (Self-Service Tenant Creation)",
        "description": "Mendaftarkan perusahaan/tenant baru secara mandiri:\n1. Membuat entri baru pada tabel `tenants`.\n2. Menghubungkan paket langganan awal (`subscription_plans`).\n3. Mendaftarkan user sebagai anggota pertama di `tenant_memberships`.\n4. Menetapkan role `TENANT_OWNER` di `user_roles`.\n5. Mencatat aksi di `audit_logs`.",
        "operationId": "register_tenant_api_v1_onboarding_register_tenant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterTenantResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/onboarding/join-company": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Validasi & Submit Registrasi Staf (via Company Code)",
        "description": "Calon staf mendaftar ke perusahaan menggunakan Company Code:\n1. Memvalidasi hash Company Code (aktif, belum kedaluwarsa, belum melampaui batas penggunaan).\n2. Menempatkan pendaftaran ke dalam `hr_approval_queue` dengan status 'pending'.\n3. Notifikasi in-app siap ditinjau oleh HR / Tenant Admin.",
        "operationId": "join_company_api_v1_onboarding_join_company_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinCompanyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinCompanyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
