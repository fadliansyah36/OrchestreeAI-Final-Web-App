  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StartupCheckResult": {
        "properties": {
          "step_number": {
            "type": "integer",
            "title": "Step Number"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_implemented_yet"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "step_number",
          "name",
          "status",
          "detail"
        ],
        "title": "StartupCheckResult"
      },
      "StartupGateReport": {
        "properties": {
          "overall_passed": {
            "type": "boolean",
            "title": "Overall Passed"
          },
          "total_steps": {
            "type": "integer",
            "title": "Total Steps"
          },
          "passed_steps": {
            "type": "integer",
            "title": "Passed Steps"
          },
          "failed_steps": {
            "type": "integer",
            "title": "Failed Steps"
          },
          "not_implemented_steps": {
            "type": "integer",
            "title": "Not Implemented Steps"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/StartupCheckResult"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "overall_passed",
          "total_steps",
          "passed_steps",
          "failed_steps",
          "not_implemented_steps",
          "checks"
        ],
        "title": "StartupGateReport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
