{
  "name": "orchestree-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:backend": "PYTHONPATH=apps/backend python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001",
    "dev:frontend": "vite",
    "dev": "concurrently --kill-others -n \"fastapi,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "start:backend": "PYTHONPATH=apps/backend python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001",
    "start:frontend": "vite preview --port 3000 --host 0.0.0.0",
    "start": "concurrently --kill-others -n \"fastapi,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "ci:content-gate": "node scripts/ci-content-gate.js",
    "ci:security-ast": "python3 scripts/security_ast_scanner.py",
    "ci:openapi": "PYTHONPATH=apps/backend python3 apps/backend/scripts/check_openapi_diff.py",
    "ci:import-linter": "PYTHONPATH=apps/backend lint-imports --config apps/backend/.importlinter",
    "ci:backend-test": "PYTHONPATH=apps/backend pytest apps/backend/tests",
    "supabase:link": "python3 infra/supabase/link.py",
    "supabase:db-push": "supabase db push",
    "db:migrate": "cd apps/backend && alembic upgrade head",
    "lint": "tsc --noEmit && node scripts/ci-content-gate.js && python3 scripts/security_ast_scanner.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-intl": "^4.14.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
